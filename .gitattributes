* text=auto eol=lf

*.py      text eol=lf
*.pyi     text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Batch files break without CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.pkl     binary
*.joblib  binary
*.npy     binary
*.parquet binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.zip     binary

# Embedded outputs make notebook diffs unreadable.
*.ipynb   text eol=lf -diff
