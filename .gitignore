# ---------------------------------------------------------------------------
# Data, model and report artefacts
# ---------------------------------------------------------------------------
# Contents are excluded but the directories themselves are tracked through a
# placeholder file, so a fresh clone still shows where each artefact belongs.
#
# Datasets are large and licence-bound: fetch them with scripts/download_data.py.
data/*
!data/.gitkeep
# Serialised models depend on the exact scikit-learn / XGBoost build that wrote
# them, so they are regenerated locally with scripts/run_training.py.
models/*
!models/.gitkeep
# Figures and tables are produced by the pipeline; a curated subset for the
# README is force-added under docs/assets/.
reports/*
!reports/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Testing and linting caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
# Scratch notebooks, not part of the project.
notebooks/

# ---------------------------------------------------------------------------
# Optuna study storage
# ---------------------------------------------------------------------------
*.db
*.sqlite3

# ---------------------------------------------------------------------------
# Editors and operating system files
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
